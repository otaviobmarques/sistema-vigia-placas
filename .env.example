# ---- Sessão ----
# Segredo para assinar o cookie de sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-este-segredo

# ---- Banco ----
# Vazio = Postgres embutido (PGlite) em ./data/pglite. Em produção, a URL do Supabase (pooler).
DATABASE_URL=

# ---- Infosimples (fonte principal do MVP) ----
# Vazio = modo simulado (multas geradas de forma determinística por placa)
INFOSIMPLES_TOKEN=
# Serviço de consulta por UF. {uf} é substituído pela UF da placa, em minúsculas.
INFOSIMPLES_SERVICE=detran/{uf}/veiculo

# ---- Asaas (pagamento principal) ----
# Vazio = modo simulado (Pix fictício + botão "simular pagamento")
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que o Asaas envia no header asaas-access-token dos webhooks
ASAAS_WEBHOOK_TOKEN=

# ---- URL pública (links de aceite do condutor, webhooks) ----
APP_URL=http://localhost:3000
